From 0f851d5a500ed67703c87877454523338849c3f4 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Wed, 18 Nov 2026 21:54:30 -0500
Subject: [PATCH 08/10] fix(validation): use 5-digit ZIP in smarty cache keys
 to stop duplicate lookups

---
 apps/api/pkg/util/address_cleaner.go | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/apps/api/pkg/util/address_cleaner.go b/apps/api/pkg/util/address_cleaner.go
index 92e31ca..6ab1c3a 100644
--- a/apps/api/pkg/util/address_cleaner.go
+++ b/apps/api/pkg/util/address_cleaner.go
@@ -175,3 +175,6 @@ func hasRedundantCityStateZip(street, city, state, zip string) bool {
 
 	return false
 }
+
+// CleanZip trims the ZIP+4 suffix; dedup and Smarty cache keys must use 5-digit ZIPs.
+func CleanZip(zip string) string { return normalizeZip(zip) }
